{
  "name": "projeto-iptv-manter-link-playwright",
  "version": "1.0.0",
  "description": "Automação de atualização de links IPTV com Playwright",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env index.js",
    "install-browsers": "npx playwright install chromium",
    "test": "playwright test",
