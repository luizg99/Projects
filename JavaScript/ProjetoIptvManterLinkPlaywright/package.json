  },
  "dependencies": {
    "axios": "^1.6.0",
    "inquirer": "^8.2.6",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "nock": "^14.0.11"
  }
}
